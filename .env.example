# KWhale-v3 environment template
POSTGRES_PASSWORD=change_me
JWT_SECRET=generate_random_64_hex
SEED_USERNAME=admin
SEED_PASSWORD=change_me
SEED_EMAIL=admin@local
SEED_DISPLAY_NAME=admin

EPHEMERAL_TTL_DAYS=14
UNLIKE_GRACE_DAYS=14
EVENTS_RETENTION_DAYS=180
STREAM_CACHE_MAX_MB=200
STREAM_CACHE_TTL_HOURS=2.0

ICM_PARTNER_KEY=
ICM_BASE_URL=https://byicloud.online
ICM_REGION=us
ICM_FALLBACK_REGION=ru
ICM_QUALITY=256K
ICM_KEEPALIVE_HOURS=24

YANDEX_MUSIC_TOKEN=
SOUNDCLOUD_CLIENT_ID=

# Modular proxy routing (set PROXY_ENABLED=false or leave empty when host VPN is active)
PROXY_ENABLED=false
SOURCE_PROXY_DEFAULT=
VPN_PROXY=
SHAZAM_PROXY=

# Source accounts encryption key (web-ui /admin)
ACCOUNTS_ENC_KEY=generate_random_64_hex
# Per-connector proxy routing (empty or 'direct' = direct); example:
# SOURCE_PROXY_DEEZER=socks5h://singbox:2080
# SOURCE_PROXY_TIDAL=socks5h://singbox:2080
# SOURCE_PROXY_YANDEX=direct